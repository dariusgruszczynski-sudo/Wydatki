# Skopiuj do .env i uzupełnij:  cp .env.example .env
#
# Wspólny PIN do logowania (wpisujecie go na ekranie startowym).
APP_PIN=1234
#
# Sekret do podpisu ciasteczka sesji. Wygeneruj losowy, np.:
#   openssl rand -hex 32
SESSION_SECRET=zmien-mnie-na-dlugi-losowy-ciag
#
# Ustaw na 1, jeśli aplikacja jest serwowana po HTTPS (zalecane za nginx z TLS).
COOKIE_SECURE=0
#
# Adres i port nasłuchu na serwerze:
#   0.0.0.0:8090    -> wejście po IP:porcie (http://46.225.229.113:8090)
#   127.0.0.1:8090  -> tylko lokalnie, pod reverse proxy (nginx)
BIND=0.0.0.0:8090
