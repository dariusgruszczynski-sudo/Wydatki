# Skopiuj do .env:  cp .env.example .env
#
# Adres i port nasłuchu na serwerze:
#   0.0.0.0:8091    -> wejście po IP:porcie (http://46.225.229.113:8091)
#   127.0.0.1:8091  -> tylko lokalnie, pod reverse proxy (nginx) — zalecane
#
# WAŻNE: port musi być INNY niż porty innych apek na tym serwerze
# (np. Wydatki używają 8090). Sprawdź `docker ps` przed uruchomieniem,
# jeśli 8091 jest już zajęty, zmień tutaj na wolny port.
BIND=0.0.0.0:8091
