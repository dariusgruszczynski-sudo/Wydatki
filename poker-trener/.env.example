# Skopiuj do .env:  cp .env.example .env
#
# Adres i port nasłuchu na serwerze:
#   0.0.0.0:8093    -> wejście po IP:porcie (http://46.225.229.113:8093)
#   127.0.0.1:8093  -> tylko lokalnie, pod reverse proxy (nginx/caddy) — zalecane
#
# WAŻNE: port musi być INNY niż porty innych apek na tym serwerze.
# Na serwerze 46.225.229.113 zajęte są m.in.: 80, 443, 8000 (gie-d),
# 8001 (fit-tracker), 8002 (it-akademia), 8003 (spiewnik-akordy),
# 8090 (spiewnik-songbook), 8091 (wydatki), 8092 (gie-d staging).
# 8093 było wolne w dniu wdrożenia — zawsze zweryfikuj przed startem:
#   docker ps --format '{{.Names}}: {{.Ports}}'
BIND=0.0.0.0:8093

# Coach AI (opcjonalnie): klucz API z https://console.anthropic.com (API Keys).
# Zwykle zaczyna się od sk-ant-api03-. Zostaw puste, żeby wyłączyć coacha AI.
ANTHROPIC_API_KEY=

# 1, jeśli apka jest serwowana po HTTPS (domena z certyfikatem).
COOKIE_SECURE=0
